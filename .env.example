# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in emails, invites and voter-card QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secrets: generate each with `openssl rand -base64 48`
SESSION_SECRET=
NIN_PEPPER=

# Email (https://resend.com). Without a key, emails are printed to the server log in development.
RESEND_API_KEY=
EMAIL_FROM="AuthVote <no-reply@your-domain.com>"

# Face service (face-service/). Use the same key on both sides.
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_KEY=
# Cosine similarity needed to match a voter to their enrolment (ArcFace).
FACE_MATCH_THRESHOLD=0.45
# Similarity at which a new registration is treated as a duplicate person.
FACE_DUPLICATE_THRESHOLD=0.6
FACE_MIN_LIVE_SCORE=0.7
FACE_REQUIRE_ANTISPOOF=true
# Development only: skip the face service so the UI can be tried without Python. Ignored in production.
FACE_SERVICE_MOCK=false

# Optional overrides for `npm run seed:demo` (defaults are in scripts/seed-demo.mjs)
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
# DEMO_VOTER_EMAIL=
